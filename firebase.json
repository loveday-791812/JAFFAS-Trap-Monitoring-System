{
  "database": {
    "rules": "database.rules.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "database": { "port": 9000 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "Website",
    "ignore": [
      "firebase.json",
      "**/.",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
          { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://cdnjs.cloudflare.com https://*.firebasedatabase.app; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://*.firebasedatabase.app wss://*.firebasedatabase.app https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-src https://trap-watch.firebaseapp.com https://*.firebasedatabase.app; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" }
        ]
      }
    ],
    "redirects": [
      { "source": "/", "destination": "/Login/login.html", "type": 302 }
    ],
    "rewrites": [
      { "source": "/api/signup",  "function": "signup" },
      { "source": "/api/resendCode",  "function": "resendCode" }, 
      { "source": "/api/verifyCode",  "function": "verifyCode" },
      { "source": "/api/magicLogin",  "function": "magicLogin" },
      { "source": "/api/requestPasswordReset",  "function": "requestPasswordReset" },
      { "source": "/api/resetPassword",  "function": "resetPassword" },
      { "source": "/api/adminUsers",  "function": "adminUsers" },
      { "source": "/api/deleteMyAccount",  "function": "deleteMyAccount" },
      { "source": "/api/auditSession",  "function": "auditSession" }
    ]
  },
  "functions": [
    {
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "venv",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "source": "functions",
      "runtime": "python314"
    },
    {
      "source": "cloud-functions",
      "codebase": "trap-watch",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
